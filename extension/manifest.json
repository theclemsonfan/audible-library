{
  "manifest_version": 3,
  "name": "Next Chapter Audible Sync",
  "version": "0.1.0",
  "description": "Read-only Audible library collector; syncs to your private Next Chapter endpoint.",
  "permissions": [
    "storage",
    "alarms",
    "tabs", "scripting"
  ],
  "host_permissions": [
    "https://www.audible.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}